# Copy to .env and adjust. Values already present in the environment take precedence.
PORT=5000
NODE_ENV=development

# Long random string; REQUIRED when NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (Vite dev server by default)
CLIENT_URL=http://localhost:5173

# SQLite database file and upload folder (relative to /server)
DB_FILE=data/portal.db
UPLOAD_DIR=uploads

# Students must register with an address on this domain (e.g. name@college.edu)
STUDENT_EMAIL_DOMAIN=college.edu

# Default placement-cell admin, created on first start if no admin exists
ADMIN_NAME=Placement Cell
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123
